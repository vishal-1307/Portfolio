# ─────────────────────────────────────────────────────────────
#  Contact form (optional)
# ─────────────────────────────────────────────────────────────
# Leave unset and the contact form falls back to opening the
# visitor's mail client (mailto:). No backend required either way.
#
# Web3Forms (https://web3forms.com) — free, no account needed:
# NEXT_PUBLIC_CONTACT_ENDPOINT=https://api.web3forms.com/submit
# NEXT_PUBLIC_WEB3FORMS_KEY=your-access-key
#
# Formspree (https://formspree.io) — endpoint only:
# NEXT_PUBLIC_CONTACT_ENDPOINT=https://formspree.io/f/your-form-id
